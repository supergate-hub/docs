# Copy to .env.local and fill in. Never commit real keys.

# Ask AI is a proof of concept and stays off unless this is true.
ASK_AI_ENABLED=false
# Chat endpoint for the panel. Leave empty under `pnpm dev` to use app/api/chat; a static
# build points it at the Ask AI Worker, such as https://docs-ask-ai.<subdomain>.workers.dev/api/chat.
NEXT_PUBLIC_CHAT_API_URL=
# OpenRouter for app/api/chat under `pnpm dev` (the Worker reads worker/.dev.vars): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Comma-separated models that support tool calling, tried in order. Free models end with `:free`.
OPENROUTER_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free
